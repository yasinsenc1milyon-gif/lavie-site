// Lavie · Cloudflare Worker ayarları (workers.dev üzerinden yayın)
{
  "name": "www",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  // Panelden eklenen değişkenler (ör. ADMIN_SIFRE) yayınlarda silinmesin
  "keep_vars": true,
  // Kartla ödeme için Shopier ürün linki (herkese açık). Boşsa kart seçeneği görünmez.
  "vars": { "SHOPIER_URUN_URL": "https://www.shopier.com/LaVieCreative/51738578" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // Bu adresler önce koda gelir; geri kalan her şey doğrudan statik dosya olarak sunulur (ücretsiz, sınırsız)
    "run_worker_first": ["/api/*", "/o/*", "/d", "/d.html", "/google26fc845d62d4047b.html"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "lavie", "database_id": "acf23174-0488-4cda-86fa-ba5a77231265" }
  ],
  "triggers": { "crons": ["0 6 * * 1"] },
  "observability": { "enabled": true }
}
